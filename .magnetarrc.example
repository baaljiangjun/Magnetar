# Magnetar CV610 configuration

# Model source: Git/HuggingFace/ModelScope/local path/URL
SOURCE=
MODEL_NAME=
TARGET_HARDWARE=Hi3516CV610
TASK_DIR=
SDK_LANG=both

# Host toolchain. Run the matching CANN setenv.sh before Magnetar.
ATC_BIN=atc
MINDCMD_BIN=mindcmd
CV610_SDK_ROOT=

# musl uses arm-v01c02-linux-musleabi-, glibc uses gnueabi-.
LIBC=musl
CROSS_COMPILE=arm-v01c02-linux-musleabi-

# Optional ATC preprocessing/quantization inputs.
AIPP_CONFIG=
QUANT_PARAM_FILE=
ATC_EXTRA_ARGS=

# MindCmd input list used for float/funcsim/instsim/board comparison.
MINDCMD_IMAGE_LIST=

# Explicit board only; no LAN/serial-port scanning or daemon installation.
BOARD_TRANSPORT=ssh
BOARD=
BOARD_USER=root
BOARD_PORT=22
BOARD_PASSWORD=
BOARD_DEPLOY_DIR=/tmp/magnetar_cv610
# BOARD_RUN_COMMAND=cd /tmp/magnetar_cv610 && ./cv610_infer model.om

# Required for NFS + serial. Ask the user; never assume COM3.
BOARD_SERIAL_PORT=
BOARD_SERIAL_BAUD=115200
# BOARD_NFS_SERVER=192.168.104.100
# BOARD_NFS_EXPORT=/cv610
# BOARD_NFS_LOCAL_ROOT=D:\nfs
# BOARD_NFS_MOUNT=/mnt/nfs

HF_TOKEN=
GITHUB_TOKEN=
GITHUB_ORG=
HF_ORG=
HF_ENDPOINT=https://hf-mirror.com

AUTO_APPROVE=false
MODE=full
